// Cloudflare Worker that serves the Page Builder as static files behind a password
// (Workers Builds runs `npx wrangler deploy`).
// "name" must match the Worker in the Cloudflare dashboard.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "template-etch",
  "compatibility_date": "2026-10-01",
  // put the site together in dist/ before every deploy (only builder/ + preview/ + _build/site/ are published)
  "build": {
    "command": "python3 _build/build_site.py"
  },
  // worker/index.js asks for the password (secret BUILDER_PASSWORD) before any file is served —
  // run_worker_first makes every request, including the static files, go through it
  "main": "worker/index.js",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  // safe to keep on: without the secret the Worker refuses every request (503)
  "workers_dev": true,
  "preview_urls": false
}
